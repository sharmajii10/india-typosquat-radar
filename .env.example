# ===========================================================================
#  T E M P L A T E   O N L Y  -  D O   N O T   P U T   R E A L   K E Y S   H E R E
# ===========================================================================
#
#  This file is COMMITTED TO GIT. It is not ignored, and it is not supposed to
#  be: it ships with the repo so other people know which variables to set.
#
#  The deploy path for this project requires a PUBLIC GitHub repository, because
#  that is the only way GitHub Actions minutes are free. So a secret written
#  here becomes world-readable the moment you push.
#
#  Put your real values in  .env.local  instead. That file IS ignored by git
#  (see .gitignore), and Next.js loads it automatically in development.
#
#      cp .env.example .env.local      # then edit .env.local, never this file
#
#  If you ever do paste a real key here by accident: rotate it. Assume it is
#  burned. Rotating takes thirty seconds; un-leaking a key is impossible.
# ===========================================================================


# --- Supabase (free tier) ---------------------------------------------------
# All three come from Project Settings -> API Keys in the Supabase dashboard,
# on the "Publishable and secret API keys" tab (NOT the legacy tab).
#
# Supabase renamed these keys. They are the same two keys as before:
#
#   dashboard "Publishable key"  sb_publishable_...  was the "anon" key
#   dashboard "Secret key"       sb_secret_...       was the "service_role" key
#
# Older projects still issue JWT-shaped keys beginning with `eyJ`. Both formats
# work. This app also accepts NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and
# SUPABASE_SECRET_KEY if you prefer Supabase's newer variable naming.

# Project Settings -> Data API -> Project URL.
# The ORIGIN ONLY. No trailing slash, and no /rest/v1 path - the client appends
# its own paths, so including one produces requests to /rest/v1/rest/v1/... and
# every query fails.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The PUBLISHABLE key (sb_publishable_...). This one is designed to be public:
# it ships to every browser that loads the site. That is safe ONLY because Row
# Level Security is configured - run supabase/migrations/0002_rls.sql, then
# prove it with `npm run check:rls`, before you deploy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR-KEY

# The SECRET key (sb_secret_...). This is a database admin credential. It
# bypasses Row Level Security entirely. Server-side only: never prefix it with
# NEXT_PUBLIC_, never commit it, never paste it into a chat or an issue.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR-KEY

# --- Job authentication * ---------------------------------------------------
# Shared secret sent by the GitHub Actions workflow as `Authorization: Bearer <secret>`
# to /api/jobs/*. Without it, anyone could use your deployment as a scanning
# proxy and burn the free tier. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
JOB_SECRET=CHANGE-ME-64-HEX-CHARS

# --- Reviewer UI ------------------------------------------------------------
# Password for the human review queue at /review. That page can publish an
# accusation and permanently allowlist a domain, so it is genuinely gated
# rather than merely unlisted.
#
# Must be at least 16 characters. If unset, the UI accepts JOB_SECRET instead so
# an existing deployment works with no new configuration - but a separate
# password is better, because JOB_SECRET also lives in GitHub Actions and is
# therefore known to more systems.
#
# If NEITHER is set the page refuses every login rather than falling open.
REVIEW_PASSWORD=

# --- Optional tuning --------------------------------------------------------
# Public base URL, used by the GitHub Actions workflow and for absolute links.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# How many brands one poll run covers before it stops (keeps a single serverless
# invocation inside Vercel Hobby's execution ceiling). Rotates across runs.
POLL_BRANDS_PER_RUN=4

# How many candidates one recheck run re-verifies.
RECHECK_BATCH_SIZE=25

# Contact address shown on the dispute/report page.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
